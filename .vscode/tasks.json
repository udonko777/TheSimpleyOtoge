{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev Server",
      "type": "npm",
      "script": "start",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          // 必要なら正規表現を使って、特定の出力をキャッチ。
          // 何も設定されていないとエラーを吐くので、空の正規表現を設定。
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[webpack-dev-server\\] Project is running",
          "endsPattern": "compiled successfully"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}